# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Opsional: Untuk bypass geoblock di VPS Tencent
# Opsi A: Menggunakan Cloudflare Worker reverse proxy
# GEMINI_BASE_URL=https://gemini-proxy.username.workers.dev

# Opsi B: Menggunakan HTTP / SOCKS5 Proxy
# HTTPS_PROXY=http://127.0.0.1:7890
